; Engine configuration file.
config_version=5

[application]

config/name="UAV Terrain Proto"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

limits/cluster_builder/max_clustered_elements=2048

textures/default_filters/anisotropic_filtering_level=16
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
environment/ssao/quality=2
environment/ssil/quality=1
environment/glow/upscale_mode=1
scaling_3d/mode=0

[shader_globals]

cloud_shadow_params={
"type": "vec4",
"value": Vector4(0, 0, 0, 0.0004)
}
cloud_shadow_tex={
"type": "sampler2D",
"value": ""
}
thermal_params={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
